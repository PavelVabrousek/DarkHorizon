# Supabase project credentials
# Copy this file to .env and fill in the values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/<your-project-id>/settings/api

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend/local-script only. Never expose this value to browser/client code.
# Used by admin scripts such as scripts/upload_eclipses.js and compute_horizon.py --db-batch.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function CORS allow-list origin.
# Example production value: https://darkhorizon.app
ALLOWED_ORIGIN=
